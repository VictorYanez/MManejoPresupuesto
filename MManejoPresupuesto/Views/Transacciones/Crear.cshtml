@model TransaccionCreacionViewModel

@{
    ViewData["Title"] = "Crear Transacción";
}
    
<h1>@ViewData["Title"]</h1>
<h5>Una transacción te permite especificar ingresos y gastos en particular </h5>

<form asp-action="Crear"> 
        @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
     
    <!-- Definición de Fecha Transacción  -->
    <div class="mb-3">
        <label asp-for="FechaTransaccion" class="form-label"></label>
        <input asp-for="FechaTransaccion" class="form-control" />
        <span asp-validation-for="FechaTransaccion" class="text-danger"></span>
    </div>

    <!-- Definición de Cuentas  -->
    <div class="mb-3">
        <label asp-for="CuentaId" class="form-label"></label>
        <Select asp-for="CuentaId" asp-items="Model.Cuentas" class="form-select">
        </Select>
        <span asp-validation-for="CuentaId" class="text-danger"></span>
    </div>

    <!-- Definición de Tipo Operación   -->
    <div class="mb-3">
        <label asp-for="TipoOperacionId" class="form-label"></label>
        <Select asp-for="TipoOperacionId" asp-items="Html.GetEnumSelectList<TipoOperacion>()" class="form-select">
        </Select>
        <span asp-validation-for="TipoOperacionId" class="text-danger"></span>
    </div>

    <!-- Definición de Categorias  -->
    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label"></label>
        <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select"></select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>

    <!-- Definición de Monto  -->
    <div class="mb-3">
        <label asp-for="Monto" class="form-label"></label>
        <input asp-for="Monto" class="form-control" />
        <span asp-validation-for="Monto" class="text-danger"></span>
    </div>

    <!-- Definición de Nota  -->
    <div class="mb-3">
        <label asp-for="Nota" class="form-label"></label>
        <textarea asp-for="Nota" class="form-control"></textarea>
        <span asp-validation-for="Nota" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Enviar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>

</form>

@section Scripts {
<partial name="_ValidationScriptsPartial" />

    <script>
        const urlObtenerCategorias = '@Url.Action("ObtenerCategorias", "Transacciones")';

        $(function () {
            $('#TipoOperacionId').on('change', async function () {

                const tipoOperacion = parseInt(this.value);

                // Try to read antiforgery token from the form if present
                const token = $('input[name="__RequestVerificationToken"]').val() || '';

                const response = await fetch(urlObtenerCategorias, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        tipoOperacionId: tipoOperacion
                    })
                });

                if (!response.ok) {
                    console.error('Error fetching categorias', response.status);
                    return;
                }

                const categorias = await response.json();

                const options = categorias.map(c =>
                    `<option value="${c.value}">${c.text}</option>`
                ).join('');

                $('#CategoriaId').html(options);
            });
        });
    </script>


}